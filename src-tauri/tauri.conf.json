{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskify",
  "version": "6.9.0",
  "identifier": "com.deskify.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Deskify - AI Assistant",
        "width": 560,
        "height": 184,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": false,
        "visible": false,
        "center": false,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "info.plist",
      "deskify.desktop"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {}
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:deskify.db"
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/1nird/Deskify/releases/latest/download/latest.json"
      ],
      "pubkey": "deskify.key.pub",
      "dialog": false
    }
  }
}
